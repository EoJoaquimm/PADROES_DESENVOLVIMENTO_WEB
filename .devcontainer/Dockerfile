#DEFINICAO DA IMAGEM
FROM maven:3.9-eclipse-temurin-21-noble

# DESABILITA A INSTALACAO INTERATIVA
ENV DEBIAN_FRONTEND=noninteractive

# INSTALA AS FERRAMENTAS QUE NAO EXISTEM NA IMAGEM BASE
# REMOVE OS ARQUIVOS TEMPORARIOS PROVENIENTES DO PROCESSO DE INSTALACAO
# APT-GET UPDATE - ATUALIZA O REPOSITORIO DE SOFTWARES 
# APT-GET INSTALL - INSTALA AS FERRAMENTAS
# GITS-LFS - FERRAMENTA PARA ARMAMAZENAMENTO DE ARQUIVOS BINARIOS
# CURL - FERRAMENTAS PARA TESTAR APIs
# PT-GET CLEAN E RM - LIMPAM OS ARQUIVOS TEMPORARIOS
# DOCKER FILE SERVE PARA CONFIGURAR O SISTEMA OPERACIONAL QUE VOCE VAI UTILIZAR
RUN apt-get update && apt-get install -y \
    mysql-server-8.0 \
    git \
    git-lfs \
    curl \
    unzip \
    zip \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
